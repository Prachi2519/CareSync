# Core
# Local PostgreSQL. Vercel Marketplace database integrations inject their own DATABASE_URL.
DATABASE_URL="postgresql://caresync@localhost:5432/caresync?schema=public"
AUTH_SECRET="replace-with-a-random-32-character-secret"
APP_URL="http://localhost:3000"
CRON_SECRET="replace-with-a-separate-random-secret"

# Groq LLM (optional; a safe deterministic fallback is used when omitted)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# SMTP email (optional; jobs are marked sent in console mode when omitted)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="CareSync <appointments@example.com>"
SMTP_REPLY_TO=""

# Notification formatting and Docker worker interval (CRON_INTERVAL_MS is not used on Vercel)
APP_TIMEZONE="Asia/Kolkata"
CRON_INTERVAL_MS="300000"

# Google Calendar OAuth 2.0 (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Production: https://YOUR_VERCEL_DOMAIN/api/integrations/google/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"
